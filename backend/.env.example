# JOD Weddings Environment Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@localhost:5432/jod_weddings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jod_weddings

# Static Files Directory (Frontend)
FRONTEND_DIR=../frontend

# Uploads Directory
UPLOAD_DIR=../frontend/assets/uploads

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000", "http://localhost:3000"]
